# -------------------------------------------------------------------
# Staging site
# -------------------------------------------------------------------
STAGING_URL=https://staging.kitchenwarehouse.com.au

# -------------------------------------------------------------------
# Auth — Kinde login (email/password or Google/Safari SSO).
# TEST_USER_EMAIL is also the Google account used for Google Pay.
# -------------------------------------------------------------------
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Guest checkout that uses an email that already exists in the system.
# Defaults to TEST_USER_EMAIL if left blank.
GUEST_EXISTING_EMAIL=

# New-user tests generate a fresh random inbox at this domain. Default
# is yopmail.com (auto-provisions on demand). Change to another temp
# service if you want (mail.tm, sharklasers.com, etc.).
# TEMP_EMAIL_DOMAIN=yopmail.com

# -------------------------------------------------------------------
# Credit Card (Cybersource sandbox)
# Approved Visa test card. Cardholder is not required by the KWH form.
# -------------------------------------------------------------------
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXPIRY_MONTH=12
TEST_CARD_EXPIRY_YEAR=2030
TEST_CARD_CVV=123

# Optional dedicated CC test buyer (falls back to TEST_USER_* if blank)
CC_TEST_EMAIL=
CC_TEST_PASSWORD=

# -------------------------------------------------------------------
# PayPal (sandbox)
# -------------------------------------------------------------------
PAYPAL_SANDBOX_EMAIL=
PAYPAL_SANDBOX_PASSWORD=

# -------------------------------------------------------------------
# Afterpay (sandbox)
# -------------------------------------------------------------------
AFTERPAY_SANDBOX_EMAIL=
AFTERPAY_SANDBOX_PASSWORD=

# -------------------------------------------------------------------
# Apple Pay (sandbox / test buyer)
# -------------------------------------------------------------------
APPLEPAY_EMAIL=
APPLEPAY_PASSWORD=

# -------------------------------------------------------------------
# Google Pay — no per-test credentials. `tests/auth.setup.ts` signs
# into Google once at the very start of every run using TEST_USER_EMAIL
# / TEST_USER_PASSWORD, and the resulting storageState carries the
# Chrome Google session into every chromium / android-chrome test.
# GPay specs just click the Google Pay button.
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Address finder — the tests type a random 3-char string (letters or
# digits) scoped to the country selector and pick the first suggestion.
# No env vars needed.
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Click & Collect — the tests auto-pick the first store showing
# "In Stock". No env var needed.
# -------------------------------------------------------------------

# -------------------------------------------------------------------
# Discounts — Promo code
# -------------------------------------------------------------------
PROMO_CODE=

# -------------------------------------------------------------------
# Discounts — Gift card
# The suite fetches the KWH gift-card Google Sheet at test time and
# picks the first code whose Status column is empty. The sheet must be
# shared "Anyone with the link — Viewer" for anon CSV export.
# Override the target sheet with GIFT_CARD_SHEET_ID / _GID.
# If the fetch fails, tests fall back to GIFT_CARD_NUMBER.
# -------------------------------------------------------------------
GIFT_CARD_SHEET_ID=1sPqMhQpgJMIEyWKHVoIShyt35MufE_KCC8XS1pnhwbo
GIFT_CARD_SHEET_GID=114523460
GIFT_CARD_NUMBER=
GIFT_CARD_PIN=

# -------------------------------------------------------------------
# Products — the suite adds products by typing a random kitchen search
# term (napkins, casserole, pans, knives, wolstead, …) into the site
# search and picking a random result. Tests that need cart total > 200
# AUD (e.g. gift-card 6.2) keep adding until the threshold is hit.
#
# Override the search pool with a comma-separated list, or point the
# fallback listing at a specific path.
# -------------------------------------------------------------------
# KITCHEN_SEARCH_TERMS=pans,knives,wolstead,casserole,kettle
PRODUCT_LISTING_PATH=/clearance

# -------------------------------------------------------------------
# CI / reporting
# -------------------------------------------------------------------
CI=false
BASE_TIMEOUT_MS=60000
